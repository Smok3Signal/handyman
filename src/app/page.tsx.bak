  "The price changes once the job has already started",
  "Nothing in writing if something goes wrong",
];
const SOLUTIONS = [
  "Every profile shows real ratings and job history",
  "Price is agreed and locked before work begins",
  "Every job is logged, and disputes are reviewed fairly",
];

const SERVICES = [
  { label: "Plumbing", icon: Wrench, from: "#C1652E", to: "#7A3524", big: true, blurb: "Leaks, installs, and repiping" },
  { label: "Electrical", icon: Zap, from: "#3B6E8C", to: "#22333F" },
  { label: "Painting", icon: Paintbrush, from: "#B85C6B", to: "#6E3641" },
  { label: "Mechanic", icon: Car, from: "#5B6773", to: "#211E1A" },
  { label: "Cleaning", icon: Sparkles, from: "#4E8C7C", to: "#22403A" },
  { label: "Carpentry", icon: Hammer, from: "#8B5E34", to: "#4A2F1B", big: true, blurb: "Furniture, framing, and fittings" },
  { label: "AC repair", icon: Snowflake, from: "#5FA8C8", to: "#243B45" },
  { label: "Everything else", icon: HardHat, from: COPPER, to: AMBER },
];

const TECHS = [
  { name: "Uche N.", trade: "Plumbing", rating: "4.9", jobs: 134, location: "Lekki, Lagos", initials: "UN", from: "#C1652E", to: "#7A3524" },
  { name: "Kelechi I.", trade: "Electrical", rating: "4.8", jobs: 89, location: "Surulere, Lagos", initials: "KI", from: "#3B6E8C", to: "#22333F" },
  { name: "Blessing A.", trade: "Painting", rating: "5.0", jobs: 211, location: "Victoria Island, Lagos", initials: "BA", from: "#B85C6B", to: "#6E3641" },
  { name: "Femi K.", trade: "Carpentry", rating: "4.7", jobs: 67, location: "Ikeja, Lagos", initials: "FK", from: "#8B5E34", to: "#4A2F1B" },
  { name: "Ngozi C.", trade: "Cleaning", rating: "5.0", jobs: 98, location: "Ajah, Lagos", initials: "NC", from: "#4E8C7C", to: "#22403A" },
];

const HERO_CARDS = [
  { trade: "Plumbing", name: "Uche N.", rating: "4.9", initials: "UN", from: COPPER, to: RUST, rot: -9, x: -46, y: 10, z: 10 },
  { trade: "Electrical", name: "Kelechi I.", rating: "4.8", initials: "KI", from: "#3B6E8C", to: "#22333F", rot: 4, x: 30, y: -18, z: 20 },
  { trade: "Painting", name: "Blessing A.", rating: "5.0", initials: "BA", from: AMBER, to: COPPER, rot: 14, x: 10, y: 30, z: 30 },
];

/* ─── Small utilities ─────────────────────────────────────────────*/
function FadeIn({ children, className = "", delay = 0 }: { children: React.ReactNode; className?: string; delay?: number }) {
  const ref = useRef<HTMLDivElement>(null);
  const inView = useInView(ref, { once: true, margin: "-64px" });
  return (
    <motion.div
      ref={ref}
      initial={{ opacity: 0, y: 18 }}
      animate={inView ? { opacity: 1, y: 0 } : {}}
      transition={{ duration: 0.6, delay, ease: [0.22, 1, 0.36, 1] }}
      className={className}
    >
      {children}
    </motion.div>
  );
}

function GradientNumber({ value, from, to }: { value: string; from: string; to: string }) {
  return (
    <span
      className="text-4xl lg:text-[2.75rem] font-semibold leading-none"
      style={{
        ...F_DISPLAY,
        backgroundImage: `linear-gradient(135deg, ${from}, ${to})`,
        WebkitBackgroundClip: "text",
        backgroundClip: "text",
        color: "transparent",
      }}
    >
      {value}
    </span>
  );
}

/* Faint procedural grain — cheap tactile depth across the whole page */
const GRAIN =
  "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>";

/* ─── Page ─────────────────────────────────────────────────────── */
export default function HomePage() {
  const { data: session, status } = useSession();
  const router = useRouter();
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    if (status === "authenticated") {
      const role = (session?.user as any)?.role;
      router.push(role === "EMPLOYER" ? "/employer/dashboard" : "/technician/dashboard");
    }
  }, [status, session, router]);

  useEffect(() => {
    function onScroll() { setScrolled(window.scrollY > 12); }
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
