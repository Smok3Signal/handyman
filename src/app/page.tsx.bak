/* ─── Fonts ─────────────────────────────────────────────────────────
   Swapped from next/font/google (Space_Grotesk / IBM_Plex_Sans) to
   system font stacks. The Google Fonts fetch at build time was
   hanging/failing the compile of this route specifically, breaking
   only the landing page while every other route (no font import)
   worked fine. These stacks are visually close — geometric/technical
   sans for display, clean humanist sans for body — with zero network
   dependency, so the page can never fail to compile on this again.
────────────────────────────────────────────────────────────────── */
const F_DISPLAY = {
  fontFamily:
    '"Avenir Next", "Century Gothic", "Futura", "Segoe UI", ui-sans-serif, system-ui, sans-serif',
};
const F_BODY = {
  fontFamily:
    '"Segoe UI", "Helvetica Neue", Roboto, ui-sans-serif, system-ui, sans-serif',
};

/* ─── Palette (trade-materials, not a generic theme) ─────────────
   INK   — iron/workshop base, warm near-black, not a flat #111
   SURF  — raised card surface
   COPPER/AMBER — brand + copper-pipe warmth
   STEEL — cool tool-steel counterpoint
   RUST  — deep accent reserved for the closing section
────────────────────────────────────────────────────────────────── */
const INK = "#17140F";
const SURF = "#1F1A14";
const COPPER = "#C1652E";
const AMBER = "#E3A73A";
const STEEL = "#5B6773";
const RUST = "#7A3524";
const CREAM = "#F3F1EC";
const FAINT = "#B4AA9B";

/* ─── Content ──────────────────────────────────────────────────── */
