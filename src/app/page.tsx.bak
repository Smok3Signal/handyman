              </div>
              <div
                className="p-9 md:p-12 relative"
                style={{ backgroundImage: `linear-gradient(140deg, ${RUST}, ${COPPER} 55%, ${AMBER})` }}
              >
                <div className="absolute inset-0 opacity-[0.06] mix-blend-overlay" style={{ backgroundImage: `url("${GRAIN}")` }} />
                <p className="text-sm font-medium mb-6 relative" style={{ color: "rgba(23,20,15,0.7)" }}>With HandyMan</p>
                <ul className="space-y-5 relative">
                  {SOLUTIONS.map((s) => (
                    <li key={s} className="flex gap-3 text-sm leading-relaxed font-medium" style={{ color: "#17140F" }}>
                      <span className="mt-2 w-1.5 h-1.5 rounded-full shrink-0" style={{ background: "#17140F" }} />
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </FadeIn>
        </div>
      </section>

      {/* ── Services — asymmetric bento, gradient washed per trade material ── */}
      <section id="services" className="py-28 border-t border-white/10" style={{ background: "#1A1611" }}>
        <div className="max-w-7xl mx-auto px-6">
          <FadeIn className="mb-14 max-w-xl">
            <p className="text-sm font-medium mb-3" style={{ color: COPPER }}>Services</p>
            <h2 style={{ ...F_DISPLAY, fontWeight: 600, fontSize: "clamp(1.9rem, 3.4vw, 2.75rem)", color: CREAM }} className="leading-tight">
              Every trade, one place to find it.
            </h2>
          </FadeIn>

          <div className="grid grid-cols-2 md:grid-cols-4 grid-flow-dense auto-rows-[150px] gap-4">
            {SERVICES.map((s, i) => {
              const Icon = s.icon;
              return (
                <FadeIn key={s.label} delay={i * 0.05} className={s.big ? "col-span-2 row-span-2" : "col-span-1"}>
                  <Link
                    href="/register"
                    className="group relative h-full w-full rounded-2xl border border-white/10 p-5 flex flex-col justify-between overflow-hidden transition-transform hover:-translate-y-1"
                    style={{ backgroundImage: `linear-gradient(150deg, ${s.from}33, ${s.to}66)`, boxShadow: "0 16px 32px -18px rgba(0,0,0,0.6)" }}
                  >
                    <div className="absolute inset-0 border border-white/5 rounded-2xl" style={{ boxShadow: "inset 0 1px 0 rgba(255,255,255,0.08)" }} />
                    <div
                      className="w-10 h-10 rounded-full flex items-center justify-center relative"
                      style={{ background: "rgba(255,255,255,0.12)", backdropFilter: "blur(6px)" }}
                    >
                      <Icon size={18} style={{ color: CREAM }} />
                    </div>
                    <div className="relative">
                      <p className={`font-semibold ${s.big ? "text-xl" : "text-sm"}`} style={{ ...F_DISPLAY, color: CREAM }}>{s.label}</p>
                      {s.blurb && <p className="text-xs mt-1" style={{ color: "rgba(243,241,236,0.7)" }}>{s.blurb}</p>}
                    </div>
                  </Link>
                </FadeIn>
              );
            })}
          </div>
        </div>
      </section>

      {/* ── Final CTA — rich multi-stop gradient, layered glow, grain depth ── */}
      <section className="relative overflow-hidden py-24">
        <div className="absolute inset-0" style={{ backgroundImage: `linear-gradient(135deg, ${RUST}, ${COPPER} 45%, ${AMBER})` }} />
        <div className="absolute inset-0 opacity-[0.05] mix-blend-overlay" style={{ backgroundImage: `url("${GRAIN}")` }} />
        <div
          className="pointer-events-none absolute -top-24 -right-24 w-105 h-105 rounded-full blur-[110px] opacity-40"
          style={{ background: "radial-gradient(circle, rgba(255,255,255,0.5), transparent 70%)" }}
        />
        <div
          className="pointer-events-none absolute -bottom-32 -left-24 w-95 h-95 rounded-full blur-[110px] opacity-30"
          style={{ background: `radial-gradient(circle, ${INK}, transparent 70%)` }}
        />

        <FadeIn className="relative max-w-3xl mx-auto px-6 text-center">
          <h2
            style={{ ...F_DISPLAY, fontWeight: 600, fontSize: "clamp(2rem, 4vw, 3.2rem)", color: "#17140F" }}
            className="leading-tight mb-5"
          >
            Get it done, on terms you set.
          </h2>
          <p className="text-lg mb-10 max-w-xl mx-auto leading-relaxed" style={{ color: "rgba(23,20,15,0.75)" }}>
            Post what you need or start taking jobs — verification takes minutes, not days.
          </p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center">
            <Link
              href="/register"
              className="inline-flex items-center justify-center gap-2 font-semibold px-8 py-3.5 rounded-lg bg-[#17140F] text-[#F3F1EC] transition-transform hover:-translate-y-0.5"
            >
              Find a technician <ArrowRight size={17} />
            </Link>
            <Link
              href="/register?role=TECHNICIAN"
              className="inline-flex items-center justify-center gap-2 font-semibold px-8 py-3.5 rounded-lg border-2 border-[#17140F]/25 hover:border-[#17140F]/50 transition-colors"
              style={{ color: "#17140F" }}
            >
              <Wrench size={17} /> Join as a technician
            </Link>
          </div>
        </FadeIn>
      </section>

      {/* ── Footer — retained as-is per user request ─────────────────────── */}
      <footer className="bg-stone-950 border-t border-stone-800 pt-16 pb-8">
        <div className="max-w-7xl mx-auto px-6">
          <div className="grid grid-cols-1 md:grid-cols-5 gap-12 mb-12">
            {/* Brand col */}
            <div className="md:col-span-2">
              <Image src="/logo-light.png" alt="HandyMan" width={120} height={36} className="h-8 w-auto object-contain mb-4" />
              <p className="text-stone-400 text-sm leading-relaxed max-w-xs mb-6">
                Nigeria's trusted marketplace for verified home and business technicians. Fast, safe, accountable.
              </p>
              <div className="flex items-center gap-3">
                {[
                  { icon: Twitter, href: "#" },
                  { icon: Instagram, href: "#" },
                  { icon: Facebook, href: "#" },
                  { icon: Linkedin, href: "#" },
                ].map(({ icon: Icon, href }) => (
                  <motion.a
                    key={href + Icon.name}
                    href={href}
                    whileHover={{ scale: 1.2, y: -3, rotate: 6 }}
                    whileTap={{ scale: 0.9 }}
                    transition={{ type: "spring", stiffness: 400, damping: 14 }}
                    className="w-9 h-9 rounded-full bg-stone-800 hover:bg-orange-500 flex items-center justify-center transition-colors"
                  >
                    <Icon size={15} className="text-stone-400 hover:text-white transition" />
                  </motion.a>
                ))}
              </div>
            </div>

            {/* Links */}
            {[
              {
                heading: "Platform",
                links: ["How it works", "Browse technicians", "Services", "Pricing", "Leaderboard"],
              },
              {
                heading: "Company",
                links: ["About us", "Blog", "Careers", "Press", "Partners"],
              },
              {
                heading: "Support",
                links: ["Help centre", "Contact us", "Dispute resolution", "Report an issue", "Trust & Safety"],
              },
            ].map((col) => (
              <div key={col.heading}>
                <p className="text-white font-semibold text-sm mb-4">{col.heading}</p>
                <ul className="space-y-2.5">
                  {col.links.map((link) => (
                    <li key={link}>
                      <Link href="#" className="text-stone-400 hover:text-white text-sm transition">{link}</Link>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {/* Contact row */}
          <div className="flex flex-wrap gap-6 mb-10 pb-10 border-b border-stone-800">
            {[
              { icon: Phone, text: "+234 800 HANDYMAN" },
              { icon: Mail, text: "hello@handyman.ng" },
              { icon: MapPinned, text: "Lagos, Nigeria" },
            ].map(({ icon: Icon, text }) => (
              <div key={text} className="flex items-center gap-2 text-sm text-stone-400">
                <Icon size={14} className="text-orange-400" />
                <span>{text}</span>
              </div>
            ))}
          </div>

          {/* Bottom bar */}
          <div className="flex flex-col sm:flex-row items-center justify-between gap-4">
            <p className="text-stone-500 text-xs">© 2026 HandyMan Technologies Ltd. All rights reserved.</p>
            <div className="flex gap-5 text-xs text-stone-500">
              {["Privacy Policy", "Terms of Service", "Cookie Policy"].map((l) => (
                <Link key={l} href="#" className="hover:text-white transition">{l}</Link>
              ))}
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}